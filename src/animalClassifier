import json
import os
from typing import Dict, List, Tuple, Any, Optional

from PIL import Image
from ultralytics import YOLO
from bioclip import TreeOfLifeClassifier, Rank

Box = Tuple[float, float, float, float]


def clamp_box_xyxy(box: Box, w: int, h: int) -> Tuple[int, int, int, int]:
    x1, y1, x2, y2 = box
    x1 = max(0, min(int(round(x1)), w - 1))
    y1 = max(0, min(int(round(y1)), h - 1))
    x2 = max(0, min(int(round(x2)), w - 1))
    y2 = max(0, min(int(round(y2)), h - 1))

    if x2 < x1:
        x1, x2 = x2, x1
    if y2 < y1:
        y1, y2 = y2, y1

    return x1, y1, x2, y2


def crop_from_box(img: Image.Image, box: Box) -> Image.Image:
    w, h = img.size
    x1, y1, x2, y2 = clamp_box_xyxy(box, w, h)

    if (x2 - x1) < 2 or (y2 - y1) < 2:
        raise ValueError(f"Degenerate crop: {(x1, y1, x2, y2)}")

    return img.crop((x1, y1, x2, y2)).convert("RGB")


def yolo_boxes_for_image(
    yolo_model: YOLO,
    img_path: str,
    conf: float = 0.25,
    iou: float = 0.7,
    classes: Optional[List[int]] = None,
) -> List[List[float]]:
    """
    Runs YOLO on one image and returns boxes in xyxy format as lists of floats.
    """
    results = yolo_model.predict(
        source=img_path,
        conf=conf,
        iou=iou,
        classes=classes,
        verbose=False,
    )

    if not results:
        return []

    r0 = results[0]
    if r0.boxes is None or len(r0.boxes) == 0:
        return []

    xyxy = r0.boxes.xyxy.cpu().numpy().tolist()
    return [[float(x1), float(y1), float(x2), float(y2)] for x1, y1, x2, y2 in xyxy]


def run_yolo_then_bioclip_filter(
    images_dir: str,
    out_yolo_boxes_path: str = "yolo_boxes.json",
    out_filtered_boxes_path: str = "filtered_boxes.json",
    out_labels_path: str = "bioclip_labels.json",
    yolo_weights: str = "yolov8n.pt",
    yolo_conf: float = 0.25,
    yolo_iou: float = 0.7,
    yolo_classes: Optional[List[int]] = None,  # e.g., [16] for COCO dog
    bioclip_threshold: float = 0.55,
    device: str = "cpu",
) -> None:
    """
    Pipeline:
      1) Run YOLO on each image in images_dir to get boxes
      2) Crop each box
      3) Run BioCLIP on crops
      4) Keep only boxes where top-1 BioCLIP score >= bioclip_threshold
      5) Save yolo_boxes.json, filtered_boxes.json, bioclip_labels.json
    """

    # Load models once
    yolo_model = YOLO(yolo_weights)
    classifier = TreeOfLifeClassifier(device=device)

    image_files = [
        f for f in sorted(os.listdir(images_dir))
        if f.lower().endswith((".jpg", ".jpeg", ".png", ".bmp", ".webp"))
    ]

    yolo_boxes_all: Dict[str, List[List[float]]] = {}
    filtered: Dict[str, List[List[float]]] = {}
    labels: Dict[str, List[Dict[str, Any]]] = {}

    for fname in image_files:
        img_path = os.path.join(images_dir, fname)

        # 1) YOLO boxes
        boxes = yolo_boxes_for_image(
            yolo_model=yolo_model,
            img_path=img_path,
            conf=yolo_conf,
            iou=yolo_iou,
            classes=yolo_classes,
        )
        yolo_boxes_all[fname] = boxes

        if not boxes:
            continue

        # 2) Load image and crop
        img = Image.open(img_path).convert("RGB")

        crops: List[Image.Image] = []
        crop_meta: List[Dict[str, Any]] = []
        for i, b in enumerate(boxes):
            try:
                crop = crop_from_box(img, tuple(b))  # type: ignore[arg-type]
                crops.append(crop)
                crop_meta.append({"index": i, "box": b})
            except Exception as e:
                print(f"[WARN] {fname} box#{i} skipped (crop error): {e}")

        if not crops:
            continue

        # 3) BioCLIP predict (top-1 species)
        preds = classifier.predict(crops, rank=Rank.SPECIES, k=1)

        # 4) Map predictions by crop index
        pred_by_crop_idx: Dict[int, Dict[str, Any]] = {}
        for row in preds:
            crop_idx = int(row["file_name"])
            pred_by_crop_idx[crop_idx] = row

        kept_boxes: List[List[float]] = []
        kept_labels: List[Dict[str, Any]] = []

        for crop_idx, meta in enumerate(crop_meta):
            row = pred_by_crop_idx.get(crop_idx)
            if row is None:
                continue

            score = float(row.get("score", 0.0))
            if score < bioclip_threshold:
                continue

            kept_boxes.append(meta["box"])
            kept_labels.append(
                {
                    "box": meta["box"],
                    "score": score,
                    "species": row.get("species"),
                    "common_name": row.get("common_name"),
                    "genus": row.get("genus"),
                    "family": row.get("family"),
                    "order": row.get("order"),
                    "class": row.get("class"),
                    "phylum": row.get("phylum"),
                    "kingdom": row.get("kingdom"),
                }
            )

        if kept_boxes:
            filtered[fname] = kept_boxes
            labels[fname] = kept_labels

    # Save outputs
    with open(out_yolo_boxes_path, "w", encoding="utf-8") as f:
        json.dump(yolo_boxes_all, f, indent=2)

    with open(out_filtered_boxes_path, "w", encoding="utf-8") as f:
        json.dump(filtered, f, indent=2)

    with open(out_labels_path, "w", encoding="utf-8") as f:
        json.dump(labels, f, indent=2)

    kept_total = sum(len(v) for v in filtered.values())
    total_boxes = sum(len(v) for v in yolo_boxes_all.values())
    print(f"✅ YOLO boxes total: {total_boxes}")
    print(f"✅ Kept after BioCLIP (threshold={bioclip_threshold}): {kept_total}")
    print(f"✅ Wrote: {out_yolo_boxes_path}")
    print(f"✅ Wrote: {out_filtered_boxes_path}")
    print(f"✅ Wrote: {out_labels_path}")


if __name__ == "__main__":
    run_yolo_then_bioclip_filter(
        images_dir="frames",
        yolo_weights="yolov8n.pt",
        yolo_conf=0.25,
        yolo_iou=0.7,
        yolo_classes=None,
        bioclip_threshold=0.55,
        device="cpu",
    )
